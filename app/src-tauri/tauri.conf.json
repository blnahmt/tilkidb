{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tilki DB",
  "version": "0.4.1",
  "identifier": "com.tilkidb.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tilki DB",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tilki DB",
    "copyright": "© 2026 Ahmet Bilen. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Fast, keyboard-first desktop SQL client",
    "longDescription": "Tilki DB is a desktop SQL client for PostgreSQL, MySQL/MariaDB and SQLite with SSH tunnels, streamed results, a table editor, export and a production guard.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2OEQ0NzBDMzgxRjkzN0QKUldSOWt4ODRERWVObHY5b0dqekFMRXcxdk55VmFlTjZoSS9mT1RTNTg0ZCthL2lvNXR5RE0vc0sK",
      "endpoints": ["https://github.com/blnahmt/tilkidb/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}